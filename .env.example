# ============================================================
#  DYLAN AUTO — Configuration du site
#  Copiez ce fichier en ".env" puis remplissez les valeurs.
# ============================================================

# Port d'écoute du serveur (laisser 3000 sauf besoin particulier)
PORT=3000

# Adresse publique du site (utilisée dans les emails, sans / final)
SITE_URL=https://dylanauto.fr

# ---------- EMAIL DU DIRIGEANT ----------
# Toutes les demandes (contact, devis, rendez-vous) arrivent ici.
# Plusieurs adresses possibles séparées par des virgules.
OWNER_EMAIL=contact@dylanauto.fr

# ---------- ENVOI DES EMAILS (SMTP) ----------
# Le site envoie les emails via un compte SMTP.
# Exemples :
#   Gmail      : SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  (mot de passe d'application obligatoire)
#   OVH        : SMTP_HOST=ssl0.ovh.net    SMTP_PORT=465
#   Outlook    : SMTP_HOST=smtp.office365.com SMTP_PORT=587
#   Brevo      : SMTP_HOST=smtp-relay.brevo.com SMTP_PORT=587
# Si SMTP_HOST est vide, les emails sont simplement affichés dans la console (mode test).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Adresse d'expéditeur affichée aux clients (souvent identique à SMTP_USER)
MAIL_FROM="DYLAN AUTO <contact@dylanauto.fr>"

# ---------- ESPACE ADMINISTRATION ----------
# Accès à https://votre-site/admin  (identifiant + mot de passe)
ADMIN_USER=admin
ADMIN_PASSWORD=changez-moi-absolument

# Clé secrète pour signer les liens d'annulation (n'importe quelle longue phrase aléatoire)
SECRET_KEY=changez-moi-avec-une-longue-phrase-aleatoire
