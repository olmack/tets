# ============================================================
#  Vérification de documents PDF — configuration
#  Copiez ce fichier en ".env" puis remplissez les valeurs.
# ============================================================

# Nom affiché sur la page de vérification ("Ce document a bien été émis par …")
ISSUER_NAME=Mon organisme

# Adresse publique du site, inscrite dans chaque QR code (sans / final).
# IMPORTANT : elle est imprimée définitivement dans les documents émis.
# Laissez vide pour tester sur votre réseau Wi-Fi (adresse de cet ordinateur utilisée automatiquement).
# Exemple en production : BASE_URL=https://verification.mon-site.fr
BASE_URL=

# Accès à l'administration : http://localhost:3000/admin
ADMIN_USER=admin
ADMIN_PASSWORD=changez-moi

# Port du serveur
PORT=3000
